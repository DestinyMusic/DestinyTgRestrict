<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="app_accent">#38BDF8</color>
    <color name="app_background">#07090D</color>
    <color name="app_muted">#94A3B8</color>
    <color name="app_surface">#111827</color>
    <color name="app_text">#F1F5F9</color>
    <style name="AppButton" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:backgroundTint">@color/app_surface</item>
        <item name="android:textColor">@color/app_text</item>
    </style>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorControlActivated">@color/app_accent</item>
        <item name="android:colorControlHighlight">#4038BDF8</item>
        <item name="android:colorPrimary">@color/app_surface</item>
        <item name="android:colorPrimaryDark">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorHint">@color/app_muted</item>
        <item name="android:buttonStyle">@style/AppButton</item>
    </style>
</resources>